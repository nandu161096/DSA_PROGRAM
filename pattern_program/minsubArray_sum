def minsubArray(target, nums):
    left = 0
    curr_sum = 0
    min_len = float("inf")
    start_index = end_index = -1
    
    for right in range(len(nums)):
        curr_sum += nums[right]
        
        while curr_sum >= target:
            curr_len = right - left + 1
            if curr_len < min_len:
                min_len = curr_len
                start_index = left 
                end_index = right
                
            curr_sum -= nums[left]
            left += 1
    
    if min_len == float("inf"):
        return 0,[],-1,-1
    else:
        return (min_len, nums[start_index:end_index+1], start_index, end_index)
        
    
target = 7
nums = [2,3,1,2,4,3]
length, subarray, start, end = minsubArray(target, nums) 
print(minsubArray(target, nums))
