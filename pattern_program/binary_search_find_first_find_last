def binary_search_find_first(nums, target):
    left = 0
    right = len(nums) - 1
    first = -1 
    
    while left <= right:
        mid = (left + right)//2
        
        if target == nums[mid]:
            first = mid
            right = mid - 1
        elif nums[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    
    return first

def binary_search_find_last(nums, target):
    left = 0
    right = len(nums) - 1
    last = -1 
    
    while left <= right:
        mid = (left + right)//2
        
        if target == nums[mid]:
            last = mid
            left = mid + 1
        elif nums[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    
    return last
    
nums = [5,7,7,8,8,10]
target = 7
print(binary_search_find_first(nums, target))
print(binary_search_find_last(nums, target))
