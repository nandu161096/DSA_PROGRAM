#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
};

void printlist(struct node *head) {
    struct node *curr = head;
    while(curr) {
        printf("data %d\n",curr->data);
        curr = curr->next;
    }
    printf("\n");
    
}

void remove_duplicate(struct node *head) {
    struct node *curr = head, *temp = NULL;
    
    while (curr && curr->next) {
        if (curr->data == curr->next->data) {
            temp = curr->next;
            curr->next = temp->next;
            free(temp);
        } else {
            curr = curr->next;
        }
    }
    
}

int main()
{
    int arr1[] = {1,1,3,3,4,4,5}, n = sizeof(arr1)/sizeof(arr1[0]);
    int i = 0;
    struct node *temp = NULL, *head = NULL, *prev = NULL;
    for(i = 0; i <n;i++) {
        temp = (struct node*)malloc(sizeof(struct node));
        temp->data = arr1[i];
        temp->next = NULL;
        if (head == NULL) {
            head = temp;
        } else {
            prev->next = temp;
        }
        prev = temp;
    }
    printlist(head);
    remove_duplicate(head);
    printf("After removing remove_duplicate\n");
    printlist(head);
    return 0;
}
